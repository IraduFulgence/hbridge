{
  "name": "hbridge",
  "version": "0.1.0",
  "private": true,
  "description": "HBridge — Closed-Loop Chronic-Care & Mental Health Engine",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:up": "docker compose -f infrastructure/docker/docker-compose.yml up -d",
    "db:down": "docker compose -f infrastructure/docker/docker-compose.yml down",
    "db:logs": "docker compose -f infrastructure/docker/docker-compose.yml logs -f",
    "db:migrate": "pnpm --filter @hbridge/api prisma migrate dev",
    "db:generate": "pnpm --filter @hbridge/api prisma generate",
    "db:seed": "pnpm --filter @hbridge/api prisma db seed",
    "db:studio": "pnpm --filter @hbridge/api prisma studio",
    "db:reset": "pnpm --filter @hbridge/api prisma migrate reset --force"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^5.6.2"
  },
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=12.0.0"
  }
}