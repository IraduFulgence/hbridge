generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CHW
  NURSE
  DOCTOR
  MH_PROFESSIONAL
  ADMIN
}

model User {
  id           String   @id @default(uuid())
  email        String?  @unique
  phone        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  role         UserRole
  isActive     Boolean  @default(true)
  languagePref String   @default("rw")
  district     String?
  sector       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}